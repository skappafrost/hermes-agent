# agentmemory engine config — one shared memory pool for all Hermes profiles.
# LLM (compression/summaries) + embeddings both via NVIDIA NIM (OpenAI-compatible).
# Phase 2 (2026-09-24): switched off the Kilo gateway to NIM so vector/hybrid recall works.
AGENTMEMORY_AGENT_SCOPE=shared

# OpenAI-compatible base for BOTH the chat (compression) and embedding providers.
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=REDACTED
# Compression / summarization chat model (returns usable message.content).
OPENAI_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Embeddings: force the openai-compatible path at NIM; dimension must match the model.
EMBEDDING_PROVIDER=openai
OPENAI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
OPENAI_EMBEDDING_DIMENSIONS=2048

AGENTMEMORY_AUTO_COMPRESS=true
# Engine-side auto-distillation: slots enable structured memory units; reflect turns
# concept clusters into higher-order insights (needs SLOTS). Consolidation already on.
AGENTMEMORY_SLOTS=true
AGENTMEMORY_REFLECT=true

GRAPH_EXTRACTION_ENABLED=true
